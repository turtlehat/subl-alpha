#!/bin/sh
# Sublime Text with a translucent background.
# Usage: subl-alpha-linux [--editor OPACITY] [--chrome [OPACITY]] [subl arguments...]
#   --editor OPACITY  editor background opacity, 0 (clear) to 1 (opaque); default 0.5
#   --chrome [OPACITY]  also make the tab bar, sidebar and status bar translucent; default: the editor opacity
# Popups, panels and the GTK menu bar always stay opaque.
while :; do
	case $1 in
		--editor) SUBL_EDITOR=$2; shift 2 ;;
		--chrome)
			chrome=1; shift
			# the value is optional, so only a number counts
			case $1 in [0-9]*|.[0-9]*) chrome=$1; shift ;; esac ;;
		*) break ;;
	esac
done
[ -z "$chrome" ] || SUBL_CHROME=$( [ "$chrome" = 1 ] && echo "${SUBL_EDITOR:-0.5}" || echo "$chrome" )
export SUBL_EDITOR SUBL_CHROME

dir=$(dirname "$(readlink -f "$0")")
export LD_PRELOAD="$dir/shim.so${LD_PRELOAD:+:$LD_PRELOAD}"
exec /usr/bin/subl "$@"
